{
  "$schema": "https://json.schemastore.org/design-tokens.json",
  "brand": {
    "name": "DocuWunder",
    "claim": "Deine Dokumente. Ohne Technikstress."
  },
  "color": {
    "brand": {
      "mint": "#8EE5DA",
      "teal": "#147E73",
      "tealDark": "#116C64",
      "navy": "#0D1B2A"
    },
    "surface": {
      "default": "#FFFFFF",
      "subtle": "#F7FAFA",
      "border": "#E2EFED"
    },
    "text": {
      "primary": "#0D1B2A",
      "secondary": "#5E6B78",
